# MODELO DE CONFIGURACAO
# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo .env NAO deve ser enviado para o GitHub.

# Servidor de webhook
PORTA_SERVIDOR=5000
WEBHOOK_PATH=/api/datasheet/webhook

# Gateway interno (C#)
API_GATEWAY_URL=http://IP_DO_GATEWAY:5000/api/gateway/tarefa
CALLBACK_HOST=http://IP_DESTA_MAQUINA

# Pasta e arquivo de log
PASTA_DO_LOG=\\SERVIDOR\Pasta\Logs
NOME_ARQUIVO_LOG=log_zapzap.txt

# IA (Groq)
GROQ_API_KEY=sua_chave_groq_aqui
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b

# Palavra de login do modo administrador no privado
SENHA_ADMIN=sua_senha_aqui

# Nomes dos grupos permitidos (comparacao por "contem", em maiusculas)
NOME_GRUPO_CADASTRO=NOME DO GRUPO DE CADASTRO
NOME_GRUPO_DATASHEET=NOME DO GRUPO DE DATASHEET

# Sessao e Navegador WPPConnect
SESSION_NAME=bot-servidor
CHROME_PATH=C:\caminho\para\chrome.exe

# IA (Claude / Anthropic) - usada para descobrir o NCM pela descricao do produto
# Se ficar vazia, a consulta de NCM pelo Claude fica desligada.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
